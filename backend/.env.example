# PocketBase server admin
#
# This account logs into the PocketBase admin panel at:
# http://localhost:9010/_/
#
# It is not the same as a normal Household Chores app user.

ADMIN_EMAIL="admin@example.com"

# Keep the password in double quotes.
# If your password contains a dollar sign, write it twice.
# Example: My#Secure$Pass! becomes "My#Secure$$Pass!"

ADMIN_PASSWORD="your_secure_password_here"

# Optional Home Assistant integration
#
# Leave these commented out if you do not use Home Assistant.

# Send a webhook every time a chore is completed.
# HA_WEBHOOK_URL=http://your-home-assistant:8123/api/webhook/your-completion-webhook-id

# Send a daily digest of due, overdue, never completed, and critical chores.
# This can also be configured by an admin inside App settings.
# HA_DUE_WEBHOOK_URL=http://your-home-assistant:8123/api/webhook/your-due-reminder-webhook-id

# Due reminder schedule.
# Format: minute hour day month weekday
# Default: 08:00 every day
# HA_DUE_REMINDER_CRON=0 8 * * *

# Required for manual reminder triggers and signed completion links.
# Use a long random value that is different from your admin password.
# HA_ACTION_SECRET=replace-with-a-long-random-secret

# Public backend URL that Home Assistant can reach for action links.
# Usually this is your server IP or host name on port 9010.
# PUBLIC_BACKEND_URL=http://your-server:9010

# How long action links remain valid, in seconds.
# Default: 259200 seconds, which is 72 hours.
# HA_ACTION_TOKEN_TTL_SECONDS=259200
