# Exclude generated Flutter files that contain machine-specific paths.
frontend/.dart_tool/

# Exclude compiled output to keep Docker builds small.
frontend/build/

# Flutter generated dependency files.
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages

# Generated localization files are recreated during Docker builds.
frontend/lib/l10n/app_localizations.dart
frontend/lib/l10n/app_localizations_en.dart
frontend/lib/l10n/app_localizations_nl.dart
frontend/lib/l10n/app_localizations_es.dart

# Platform build output.
frontend/android/.gradle/
frontend/android/app/.cxx/
frontend/ios/Pods/
frontend/linux/build/
frontend/macos/build/
frontend/windows/build/

# IDE and OS state.
frontend/.idea/
**/.DS_Store

# Runtime backend data is mounted into the container, not copied into images.
backend/pb_data/
backend/web/
